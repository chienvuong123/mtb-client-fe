{
  "name": "base_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "server": "json-server db.json --port 3001",
    "dev-server": "concurrently \"yarn dev\" \"yarn server\""
